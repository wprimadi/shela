package main

import (
	"bufio"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"time"

	"github.com/fatih/color"
	"github.com/schollz/progressbar/v3"
)

// Configurable output directory
var outputDir string

func main() {
	intro()

	// Set default output directory
	outputDir = getOutputDir()
	color.Cyan("[i] Output will be saved to: %s\n", outputDir)

	bar := progressbar.NewOptions(5,
		progressbar.OptionEnableColorCodes(true),
		progressbar.OptionSetDescription("[cyan][1/5][reset] Running SUID file scan..."),
	)
	time.Sleep(1 * time.Second)
	checkSUIDFiles(bar)

	bar.Describe("[cyan][2/5][reset] Checking user accounts...")
	time.Sleep(1 * time.Second)
	checkUsers(bar)

	bar.Describe("[cyan][3/5][reset] Scanning open ports...")
	time.Sleep(1 * time.Second)
	checkOpenPorts(bar)

	bar.Describe("[cyan][4/5][reset] Checking world-writable directories...")
	time.Sleep(1 * time.Second)
	checkWorldWritableDirs(bar)

	bar.Describe("[cyan][5/5][reset] Checking crontabs...")
	time.Sleep(1 * time.Second)
	checkCrontabs(bar)

	bar.Finish()
	color.Green("\n[+] Audit completed. Reports are saved in %s\n", outputDir)
}

func intro() {
	logo := `
   ███████╗██╗  ██╗███████╗██╗     █████╗ 
   ██╔════╝██║  ██║██╔════╝██║    ██╔══██╗
   ███████╗███████║█████╗  ██║    ███████║
   ╚════██║██╔══██║██╔══╝  ██║    ██╔══██║
   ███████║██║  ██║███████╗███████╗██║  ██║
   ╚══════╝╚═╝  ╚═╝╚══════╝╚══════╝╚═╝  ╚═╝

        SHELA - SHELA Helps Evaluate Linux Access
`
	color.Set(color.FgHiMagenta)
	fmt.Println(logo)
	color.Unset()
}

func getOutputDir() string {
	if len(os.Args) > 1 {
		return os.Args[1]
	}
	dir, err := os.Getwd()
	if err != nil {
		panic(err)
	}
	return dir
}

func writeReport(filename, content string) {
	path := filepath.Join(outputDir, filename)
	f, err := os.Create(path)
	if err != nil {
		color.Red("[!] Failed to write report: %v", err)
		return
	}
	defer f.Close()
	f.WriteString(content)
}

func checkSUIDFiles(bar *progressbar.ProgressBar) {
	_, err := exec.LookPath("find")
	if err != nil {
		color.Red("[!] 'find' command not found. Skipping SUID file check.")
		writeReport("suid_files.txt", "[!] 'find' command not found. Cannot check SUID files.\n")
		bar.Add(1)
		return
	}

	cmd := exec.Command("find", "/", "-perm", "-4000", "-type", "f")
	output, err := cmd.Output()
	bar.Add(1)
	if err != nil {
		color.Red("[!] Error scanning SUID files")
		color.Red(err.Error())
		writeReport("suid_files.txt", "[!] Error running find command for SUID files.\n")
		return
	}

	files := strings.Split(string(output), "\n")
	report := "[SUID Files Found]\n"
	for _, f := range files {
		if f != "" {
			report += f + "\n"
		}
	}
	writeReport("suid_files.txt", report)
	color.Yellow("[!] Found %d SUID files.\n    -> Recommendation: Review and remove unnecessary SUID bits.\n", len(files)-1)
}

func checkUsers(bar *progressbar.ProgressBar) {
	file, err := os.Open("/etc/passwd")
	bar.Add(1)
	if err != nil {
		color.Red("[!] Cannot open /etc/passwd")
		writeReport("users.txt", "[!] Failed to open /etc/passwd.\n")
		return
	}
	defer file.Close()

	scanner := bufio.NewScanner(file)
	report := "[User Accounts Audit]\n"
	for scanner.Scan() {
		line := scanner.Text()
		parts := strings.Split(line, ":")
		if len(parts) > 6 && parts[6] == "/bin/bash" {
			report += fmt.Sprintf("User %s can login via shell\n", parts[0])
		}
	}
	writeReport("users.txt", report)
	color.Yellow("[!] Users with /bin/bash detected.\n    -> Recommendation: Disable shell access for non-admin users.\n")
}

func checkOpenPorts(bar *progressbar.ProgressBar) {
	_, err := exec.LookPath("ss")
	bar.Add(1)
	if err != nil {
		color.Red("[!] 'ss' command not found. Skipping open port check.")
		writeReport("open_ports.txt", "[!] 'ss' command not found. Cannot check open ports.\n")
		return
	}

	cmd := exec.Command("ss", "-tuln")
	output, err := cmd.Output()
	if err != nil {
		color.Red("[!] Failed to check open ports")
		writeReport("open_ports.txt", "[!] Failed to execute 'ss' command.\n")
		return
	}

	writeReport("open_ports.txt", string(output))
	color.Yellow("[!] Open ports detected.\n    -> Recommendation: Close unnecessary ports and use firewall.\n")
}

func checkWorldWritableDirs(bar *progressbar.ProgressBar) {
	_, err := exec.LookPath("find")
	if err != nil {
		color.Red("[!] 'find' command not found. Skipping world-writable directory check.")
		writeReport("world_writable_dirs.txt", "[!] 'find' command not found. Cannot check world-writable directories.\n")
		bar.Add(1)
		return
	}

	cmd := exec.Command("find", "/", "-type", "d", "-perm", "-0002", "-print")
	output, err := cmd.Output()
	bar.Add(1)
	if err != nil {
		color.Red("[!] Error finding world-writable dirs")
		color.Red(err.Error())
		writeReport("world_writable_dirs.txt", "[!] Error running find command for world-writable directories.\n")
		return
	}
	writeReport("world_writable_dirs.txt", string(output))
	color.Yellow("[!] World-writable directories found.\n    -> Recommendation: Restrict permissions on sensitive directories.\n")
}

func checkCrontabs(bar *progressbar.ProgressBar) {
	_, err := exec.LookPath("ls")
	if err != nil {
		color.Red("[!] 'ls' command not found. Skipping crontab check.")
		writeReport("crontabs.txt", "[!] 'ls' command not found. Cannot check crontabs.\n")
		bar.Add(1)
		return
	}

	cmd := exec.Command("ls", "/var/spool/cron")
	output, err := cmd.Output()
	bar.Add(1)
	if err != nil {
		color.Red("[!] Crontab check failed")
		writeReport("crontabs.txt", "[!] Failed to list crontab directory.\n")
		return
	}
	writeReport("crontabs.txt", string(output))
	color.Yellow("[!] User crontabs detected.\n    -> Recommendation: Review periodic tasks for malicious jobs.\n")
}
